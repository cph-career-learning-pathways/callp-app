# Manage CaLLP web access through Elastic Beanstalk's CloudFormation stack.
# These rules are recreated automatically when the environment is provisioned.

Resources:
  CaLLPHttpsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
      Description: Allow public HTTPS

  CaLLPInstanceConnectIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 22
      ToPort: 22
      CidrIp: 18.237.140.160/29
      Description: Allow restricted EC2 Instance Connect
